# .env.example
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://clipcreator:changeme@localhost:5432/clipcreator
POSTGRES_DB=clipcreator
POSTGRES_USER=clipcreator
POSTGRES_PASSWORD=changeme

# --- Storage ---
MEDIA_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=2048

# --- Video processing ---
FFMPEG_PATH=/usr/bin/ffmpeg

# --- B-roll (optional) ---
# Free API key from https://www.pexels.com/api/ . Used to fetch a background
# image/video matching each source video's title/filename via simple keyword
# search. Leave blank to skip B-roll entirely (clips fall back to a blurred
# copy of their own footage as the background).
PEXELS_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- CORS ---
# Must match the frontend's actual origin. The dockerized frontend (nginx)
# serves on port 80, so this is plain "http://localhost" (no port), NOT the
# Vite dev server's default of http://localhost:5173.
FRONTEND_ORIGIN=http://localhost
